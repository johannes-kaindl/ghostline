{
  "sources": {
    "obsidian-kit": {
      "ref": "0.51.2"
    },
    "code-kit": {
      "ref": "0.15.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "sse",
        "endpoint",
        "endpoint_config",
        "error_body",
        "i18n",
        "settings",
        "reasoning",
        "sampling-profiles",
        "ignore",
        "timeout",
        "model-choice",
        "think-splitter",
        "endpoint_diagnostics",
        "model-list-cache",
        "backend-probe",
        "capabilities",
        "redact",
        "secrets"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": [
        "clipboard"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "endpoint-source"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "./"
        ],
        [
          "../vendor/code-kit/web/",
          "./"
        ],
        [
          "../pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "settings_walker",
        "endpoint-source",
        "model-picker",
        "request-section",
        "request-session",
        "collapsible",
        "chat-client",
        "chat-transport",
        "shortcuts-bridge",
        "clock",
        "help-setting",
        "folder-suggest",
        "clipboard",
        "secrets",
        "endpoint-secrets",
        "endpoint-list",
        "llm-connection",
        "llm-connection-strings",
        "backend-probe"
      ],
      "rewrite": [
        [
          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/web/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "kit-css",
        "obsidian-mock"
      ]
    }
  ]
}
